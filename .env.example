# These values match compose.dev.yml (a local Postgres in Docker). On a server, use real ones.
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory
TEST_DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory_test
# openssl rand -hex 32 generates a real one
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Registration is closed unless this is "true". Open it to create the first user, then close it again.
ALLOW_REGISTRATION=false
